# Copy to .env and fill in
ANTHROPIC_API_KEY=

# Supabase (staging) — Dashboard → Settings → API
# Service role key is SERVER-SIDE ONLY. Never ship to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter — for non-Claude text models (GPT-5, Gemini Flash, etc.)
# per the hybrid routing decision in docs/2026-05-24-engineering-refinement.md
# (Anthropic direct for caching; OpenRouter for everything else text).
# Sign up: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# fal.ai — image specialists (a19/a20/a21/a22/a23). One key hosts
# Flux 1.1 Pro, Flux schnell, Recraft, SDXL, vision models for a24 QA.
# Sign up: https://fal.ai/dashboard/keys
FAL_API_KEY=

# Exa — web research (Site Scanner, Competitor Map). Neural/keyword search.
# Sign up: https://exa.ai (Dashboard → API Keys)
EXA_API_KEY=

# Optional — defaults shown
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
MODEL=claude-sonnet-4-6

# BIO Discovery v2 pipeline: multi-page crawl + uploaded sources + Instagram + visual extraction.
# Off by default (single-page, cheap). Set to 1 to enable the full accuracy pipeline.
DISCOVERY_V2=0

# Firecrawl — web scraping for Discovery v2 multi-page crawl.
# REQUIRED whenever DISCOVERY_V2=1 (compile-bio throws without it). Sign up: https://firecrawl.dev
FIRECRAWL_API_KEY=

# Inngest — background job queue (BIO compilation).
# LOCAL DEV: leave the two keys blank and set INNGEST_DEV=1 to use the local dev server.
# PRODUCTION: remove INNGEST_DEV, set both keys from the Inngest Cloud dashboard,
# and register the app URL https://<your-host>/api/inngest there.
INNGEST_DEV=1
INNGEST_BASE_URL=http://localhost:8288
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Public origin of the deployed app (single-origin: same host serves API + SPA).
# Used for Stripe checkout success/cancel return URLs. Dev: http://localhost:5173
APP_URL=http://localhost:5173

# Stripe — self-serve tier upgrades (Day 3). Server-side only, never VITE_.
# Create two recurring Prices (01 Dam, 02 River) + a webhook endpoint in the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_DAM=
STRIPE_PRICE_RIVER=

# Resend — transactional/notification email. Without it, notifications degrade
# to in-app only (sends are skipped with a warning). Sign up: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=CaastorOS <notifications@caastoros.com>
